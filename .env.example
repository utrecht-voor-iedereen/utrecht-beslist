# Utrecht Beslist Environment Variables

# AI Provider API Keys (Optional - Fallback to Degraded Mode if omitted)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model override (Optional)
AI_MODEL=openai/gpt-oss-120b
# Groq models tried in order when one fails or runs out of its day (per-model limits).
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Fallback outside Groq: a free key from https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
